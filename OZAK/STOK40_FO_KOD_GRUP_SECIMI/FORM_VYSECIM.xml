FORM FRM_VYSECIM W=460p H=340p SCROLLBARS=NO CAPTIONTYPE=SYS
	SET CAPTION="VY Ozellik Secimi"
	DEFINEFONT ID="default_font" FACE=DEFAULT POINT=DEFAULT
	DEFINEFONT ID="default_text_font" FACE=DEFAULT POINT=DEFAULT
	DEFINEFONT ID="default_edittext_font" FACE=DEFAULT POINT=DEFAULT
	DEFINEFONT ID="default_button_font" FACE=DEFAULT POINT=DEFAULT
	SET DEFAULTFONT=default_font
	SET DEFAULTFONT_TEXT=default_text_font
	SET DEFAULTFONT_EDITTEXT=default_edittext_font
	SET DEFAULTFONT_BUTTON=default_button_font

	LTEXT LEFT=10P TOP=10P W=420P H=18P T="Ozellikleri secin (E/H). Faz1: OK = Grup listesi MsgBox (SCFOEN yok)."

	GRID LEFT=10P TOP=35P W=430P H=240P TABLE=VYSECIM_STACK HEADERROWHEIGHT=DEFAULT
		EDITTEXT D="OZELLIK" CAPTION="Ozellik" W=300P NOEDIT=Y
		CHECKBOX D="SEC" CAPTION="Sec" W=80P TRUEFALSE=EH
	ENDGRID

	BUTTON LEFT=10P TOP=290P W=80P H=23P CAPTION="Tamam" ID="MT_RUNMACRO_AFTERCALC('EFRM10.THISFORM','cmd_VySecimOK')" FRAMESTYLE=BUTTON
	BUTTON LEFT=100P TOP=290P W=80P H=23P CAPTION="Iptal" ID=ID_APP_OK FRAMESTYLE=BUTTON
ENDFORM
